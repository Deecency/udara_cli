{
  "name": "udara-whitelabel",
  "displayName": "Udara Whitelabel",
  "description": "Browse whitelabel clients and their env files, then run or build any client with udara_cli.",
  "version": "0.1.1",
  "publisher": "deecency",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Deecency/udara_cli",
    "directory": "extensions/vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "flutter",
    "whitelabel",
    "udara",
    "build"
  ],
  "icon": "media/icon.png",
  "activationEvents": [
    "workspaceContains:clients/",
    "workspaceContains:pubspec.yaml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "udara",
          "title": "Udara",
          "icon": "media/udara.svg"
        }
      ]
    },
    "views": {
      "udara": [
        {
          "id": "udara.clients",
          "name": "Clients",
          "icon": "media/udara.svg",
          "contextualTitle": "Udara Clients"
        },
        {
          "id": "udara.history",
          "name": "Build History",
          "icon": "media/udara.svg",
          "contextualTitle": "Udara Build History"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "udara.clients",
        "contents": "No Flutter project with a clients/ folder was found in this workspace.\n[Set up clients](command:udara.setupClients)\nRequires udara_cli: `dart pub global activate udara_cli`.",
        "when": "!udara.hasClients"
      },
      {
        "view": "udara.history",
        "contents": "No builds recorded yet. Build a client from the Clients view and it will show up here.",
        "when": "!udara.hasHistory"
      }
    ],
    "commands": [
      {
        "command": "udara.refresh",
        "title": "Refresh",
        "category": "Udara",
        "icon": "$(refresh)"
      },
      {
        "command": "udara.run",
        "title": "Run Client (whitelabel + flutter run)",
        "category": "Udara",
        "icon": "$(play)"
      },
      {
        "command": "udara.runTest",
        "title": "Run Client with Test Env",
        "category": "Udara",
        "icon": "$(beaker)"
      },
      {
        "command": "udara.build",
        "title": "Build Client\u2026",
        "category": "Udara",
        "icon": "$(package)"
      },
      {
        "command": "udara.whitelabel",
        "title": "Whitelabel Project as Client",
        "category": "Udara",
        "icon": "$(paintcan)"
      },
      {
        "command": "udara.doctor",
        "title": "Doctor",
        "category": "Udara",
        "icon": "$(pulse)"
      },
      {
        "command": "udara.clean",
        "title": "Clean (restore project state)",
        "category": "Udara",
        "icon": "$(clear-all)"
      },
      {
        "command": "udara.diff",
        "title": "Diff Two Clients\u2026",
        "category": "Udara",
        "icon": "$(diff)"
      },
      {
        "command": "udara.setupClients",
        "title": "Set Up Clients\u2026",
        "category": "Udara",
        "icon": "$(add)"
      },
      {
        "command": "udara.openEnv",
        "title": "Open Env File",
        "category": "Udara",
        "icon": "$(go-to-file)"
      },
      {
        "command": "udara.copyValue",
        "title": "Copy Value",
        "category": "Udara",
        "icon": "$(copy)"
      },
      {
        "command": "udara.revealArtifact",
        "title": "Reveal Artifact",
        "category": "Udara",
        "icon": "$(folder-opened)"
      },
      {
        "command": "udara.copyError",
        "title": "Copy Error",
        "category": "Udara",
        "icon": "$(copy)"
      },
      {
        "command": "udara.clearHistory",
        "title": "Clear Build History",
        "category": "Udara",
        "icon": "$(trash)"
      },
      {
        "command": "udara.installCli",
        "title": "Install udara_cli",
        "category": "Udara"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "udara.openEnv",
          "when": "false"
        },
        {
          "command": "udara.copyValue",
          "when": "false"
        },
        {
          "command": "udara.revealArtifact",
          "when": "false"
        },
        {
          "command": "udara.copyError",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "udara.refresh",
          "when": "view == udara.clients",
          "group": "navigation@1"
        },
        {
          "command": "udara.setupClients",
          "when": "view == udara.clients",
          "group": "navigation@2"
        },
        {
          "command": "udara.doctor",
          "when": "view == udara.clients",
          "group": "navigation@3"
        },
        {
          "command": "udara.diff",
          "when": "view == udara.clients",
          "group": "1_actions@1"
        },
        {
          "command": "udara.clean",
          "when": "view == udara.clients",
          "group": "1_actions@2"
        },
        {
          "command": "udara.refresh",
          "when": "view == udara.history",
          "group": "navigation@1"
        },
        {
          "command": "udara.clearHistory",
          "when": "view == udara.history",
          "group": "1_actions@1"
        }
      ],
      "view/item/context": [
        {
          "command": "udara.run",
          "when": "view == udara.clients && viewItem == client",
          "group": "inline@1"
        },
        {
          "command": "udara.build",
          "when": "view == udara.clients && viewItem == client",
          "group": "inline@2"
        },
        {
          "command": "udara.run",
          "when": "view == udara.clients && viewItem == client",
          "group": "1_run@1"
        },
        {
          "command": "udara.runTest",
          "when": "view == udara.clients && viewItem == client",
          "group": "1_run@2"
        },
        {
          "command": "udara.build",
          "when": "view == udara.clients && viewItem == client",
          "group": "1_run@3"
        },
        {
          "command": "udara.whitelabel",
          "when": "view == udara.clients && viewItem == client",
          "group": "2_project@1"
        },
        {
          "command": "udara.doctor",
          "when": "view == udara.clients && viewItem == client",
          "group": "2_project@2"
        },
        {
          "command": "udara.openEnv",
          "when": "view == udara.clients && viewItem == envFile",
          "group": "inline"
        },
        {
          "command": "udara.copyValue",
          "when": "view == udara.clients && viewItem == envEntry",
          "group": "inline"
        },
        {
          "command": "udara.revealArtifact",
          "when": "view == udara.history && viewItem == historyArtifact",
          "group": "inline"
        },
        {
          "command": "udara.copyError",
          "when": "view == udara.history && viewItem == historyFailed",
          "group": "inline"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "udara",
        "required": [
          "label"
        ],
        "properties": {
          "label": {
            "type": "string",
            "description": "Task label"
          }
        }
      }
    ],
    "configuration": {
      "title": "Udara Whitelabel",
      "properties": {
        "udara.cliPath": {
          "type": "string",
          "default": "udara_cli",
          "description": "Path or command used to invoke udara_cli."
        },
        "udara.flutterPath": {
          "type": "string",
          "default": "flutter",
          "description": "Path or command used to invoke flutter for 'Run Client'."
        },
        "udara.flutterRunArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments for 'flutter run' (e.g. [\"--flavor\", \"dev\"]). Passed as toolArgs in native mode."
        },
        "udara.defaultBuildType": {
          "type": "string",
          "enum": [
            "aab",
            "apk"
          ],
          "default": "aab",
          "description": "Pre-selected Android build type in the Build picker."
        },
        "udara.maskSecrets": {
          "type": "boolean",
          "default": true,
          "description": "Mask env values whose key looks like a secret (KEY, TOKEN, SECRET, PASSWORD) in the Clients view."
        },
        "udara.askForDevice": {
          "type": "boolean",
          "default": true,
          "description": "Terminal launch mode only: show a device picker (from 'flutter devices') before 'flutter run'. In native mode the Flutter extension's device selector is used."
        },
        "udara.launchMode": {
          "type": "string",
          "enum": [
            "native",
            "terminal"
          ],
          "default": "native",
          "enumDescriptions": [
            "Launch through the Flutter extension (Dart-Code): debug toolbar, hot reload on save, breakpoints, DevTools. Falls back to a terminal when it is not installed.",
            "Run 'flutter run' in an integrated terminal (type r / R / q there)."
          ],
          "description": "How 'Run Client' starts the app after whitelabeling."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "tsc --noEmit -p ./",
    "package": "vsce package --no-dependencies",
    "test": "npm run compile && node --test test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.4.0"
  }
}
